{
  "geode": "5.11.2",
  "gd": { "android": "2.2081" },
  "id": "ivanciunicolaeandrei.alt_spam_helper",
  "name": "Alt Spam Helper",
  "version": "0.1.0",
  "developer": "Ivanciunicolaeandrei",
  "description": "Imports macro files and checks for alternating wave input patterns.",
  "settings": {
    "macro_file": {
      "type": "file",
      "name": "Import macro",
      "description": "Choose a macro file. The mod analyses it after selection.",
      "default": "",
      "control": {
        "dialog": "open",
        "filters": [
          { "files": ["*.gdr", "*.json", "*.txt", "*.macro", "*.replay", "*.dat"], "description": "Macro files" }
        ]
      }
    },
    "macro_status": {
      "type": "string",
      "name": "Macro analysis",
      "description": "Status of the selected macro.",
      "default": "No macro selected."
    },
    "helper_enabled": {
      "type": "bool",
      "name": "Helper Enabled",
      "description": "Enable the two-finger helper gesture.",
      "default": true
    },
    "spam_cps": {
      "type": "int",
      "name": "Tap rate",
      "description": "Target complete press/release cycles per second.",
      "default": 12,
      "min": 2,
      "max": 30
    }
  }
}